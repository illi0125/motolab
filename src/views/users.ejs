<%- include('includes/header') %>

  <link rel="stylesheet" type="text/css" href="/css/users.css" />

  <body>
    <div class="users-container">
      <div class="bg-cyber-grid"></div>
      <div class="bg-glow-spotlight spot-1"></div>
      <div class="bg-glow-spotlight spot-2"></div>
      <div class="bg-carbon-overlay"></div>

      <header class="navigation-menu">
        <div class="brand-badge">
          <div class="logo-icon-wrapper">
            <svg class="speedometer-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 2a10 10 0 0 0-10 10c0 4.2 2.6 7.8 6.3 9.3" stroke-linecap="round" />
              <path d="M12 2a10 10 0 0 1 10 10c0 4.2-2.6 7.8-6.3 9.3" stroke-linecap="round" />
              <path d="M12 12l4-4" stroke="#FF3E00" stroke-width="2.5" stroke-linecap="round" />
              <circle cx="12" cy="12" r="2" fill="#FF3E00" />
            </svg>
          </div>
          <span class="brand-text">MOTO<span class="highlight">
              <%= !member ? 'ADMIN' : 'LAB' %>
            </span> <small>PRO</small></span>
        </div>

        <input type="checkbox" id="nav-toggle" class="nav-toggle-input" hidden>
        <label for="nav-toggle" class="nav-toggle-label" aria-label="Toggle Navigation">
          <span class="hamburger-line"></span>
          <span class="hamburger-line"></span>
          <span class="hamburger-line"></span>
        </label>

        <nav class="nav-container">
          <ul class="nav-list">
            <% if(!member) { %>
              <li class="nav-item">
                <a class="nav-link active" href="/admin/">
                  <span class="link-icon">🏠</span>
                  <span class="link-text" style="color: #F5F5F5;">Home</span>
                </a>
              </li>
              <li class="nav-item">
                <a class="nav-link" href="/admin/signup">
                  <span class="link-icon">📝</span>
                  <span class="link-text" style="color: #F5F5F5;">Sign Up</span>
                </a>
              </li>
              <li class="nav-item">
                <a class="nav-link btn-login" href="/admin/login">
                  <span class="link-icon">🔑</span>
                  <span class="link-text" style="color: #F5F5F5;">Login</span>
                </a>
              </li>
              <% } else { %>
                <li class="nav-item">
                  <a class="nav-link" href="/admin/">
                    <span class="link-icon">🏠</span>
                    <span class="link-text" style="color: #F5F5F5;">Home</span>
                  </a>
                </li>
                <li class="nav-item">
                  <a class="nav-link" href="/admin/motorcycle/all">
                    <span class="link-icon">🏍️</span>
                    <span class="link-text" style="color: #F5F5F5;">Lineup</span>
                  </a>
                </li>
                <li class="nav-item">
                  <a class="nav-link active" href="/admin/user/all">
                    <span class="link-icon">👥</span>
                    <span class="link-text">Users</span>
                  </a>
                </li>
                <!-- <li class="nav-item" onclick="return confirm('Do you really want to logout?')">
                  <a class="nav-link btn-logout" href="/admin/logout">
                    <span class="link-icon">🚪</span>
                    <span class="link-text" style="color: #ff4d4d;">Logout</span>
                  </a>
                </li> -->
                <!-- Logout Nav Item -->
                <li class="nav-item">
                  <a class="nav-link btn-logout" id="logoutBtn" href="/admin/logout">
                    <span class="link-icon">🚪</span>
                    <span class="link-text" style="color: #ff4d4d;">Logout</span>
                  </a>
                </li>

                <!-- MotoLab Custom Logout Confirmation Modal -->
                <div id="logoutModal" class="motolab-modal-backdrop">
                  <div class="motolab-modal-card">
                    <div class="motolab-modal-header">
                      <span class="motolab-modal-icon">⚠️</span>
                      <h3 class="motolab-modal-title">Confirm Logout</h3>
                    </div>
                    <div class="motolab-modal-body">
                      <p>Are you sure you want to terminate your current session on <strong>MotoLab Admin</strong>?</p>
                    </div>
                    <div class="motolab-modal-actions">
                      <button id="cancelLogout" type="button" class="btn-modal btn-cancel">Cancel</button>
                      <a id="confirmLogout" href="/admin/logout" class="btn-modal btn-confirm">Logout</a>
                    </div>
                  </div>
                </div>
                <% } %>
          </ul>

          <div class="nav-status-widgets">
            <div class="status-pill">
              <span class="pulse-dot"></span>
              <span class="status-label">SYS ONLINE</span>
            </div>
            <div class="telemetry-snapshot">
              <span class="telemetry-icon">⚡</span>
              <span class="telemetry-val">98%</span>
            </div>
          </div>

          <div class="nav-controls">
            <button class="icon-btn nav-notification" aria-label="Notifications">
              <span class="bell-icon">🔔</span>
              <span class="notification-badge"></span>
            </button>

            <div class="user-avatar-wrapper">
              <div class="avatar-ring">
                <div class="avatar-img">
                  <% if(member) { %>
                    <%= member.mb_nick ? member.mb_nick[0].toUpperCase() : 'A' %>
                      <% } else { %>G<% } %>
                </div>
              </div>
            </div>
          </div>
        </nav>
      </header>

      <% if(!member) { %>
        <div class="users-frame unauthorized-state">
          <div class="unauthorized-card">
            <div class="lock-icon-box">🔒</div>
            <h2>ACCESS RESTRICTED</h2>
            <p>Please authenticate through the portal to view MotoLab operator access records.</p>
            <a href="/admin/login" class="btn-primary-neon">Login to Portal</a>
          </div>
        </div>
        <% } else { %>
          <div class="users-frame">
            <div class="user-dashboard-panel">

              <div class="dashboard-header-bar">
                <div class="title-group">
                  <span class="pulse-dot"></span>
                  <h2 class="header-name">USER ACCESS CONTROL</h2>
                </div>
                <div class="user-count-badge">
                  <span>TOTAL MEMBERS:</span>
                  <strong>
                    <%= users.length %>
                  </strong>
                </div>
              </div>

              <div class="table-responsive-wrapper">
                <table class="users-telemetry-table">
                  <thead>
                    <tr>
                      <th scope="col" style="width: 8%">No</th>
                      <th scope="col">Operator Name</th>
                      <th scope="col">Contact Phone</th>
                      <th scope="col" style="width: 20%">Access Status</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% users.map(function(value, index) { %>
                      <tr class="user-row">
                        <td class="col-id">#<%= index + 1 %>
                        </td>
                        <td class="col-user">
                          <div class="user-info-box">
                            <div class="user-avatar-mini">
                              <%= value.memberNick ? value.memberNick[0].toUpperCase() : 'U' %>
                            </div>
                            <span class="user-nick">
                              <%= value.memberNick %>
                            </span>
                          </div>
                        </td>
                        <td class="col-phone">
                          <%= value.memberPhone %>
                        </td>
                        <td class="col-status">
                          <select class="spec-select member-status" id="<%= value._id %>"
                            data-status="<%= value.memberStatus %>">
                            <option value="ACTIVE" <%=value.memberStatus==='ACTIVE' ? 'selected' : '' %>>🟢 ACTIVE
                            </option>
                            <option value="BLOCK" <%=value.memberStatus==='BLOCK' ? 'selected' : '' %>>🔴 BLOCK</option>
                            <option value="DELETE" <%=value.memberStatus==='DELETE' ? 'selected' : '' %>>⚠️ DELETE
                            </option>
                          </select>
                        </td>
                      </tr>
                      <% }) %>
                  </tbody>
                </table>
              </div>

            </div>
          </div>
          <% } %>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script type="text/javascript" src="/js/users.js"></script>
  </body>

  <%- include('includes/footer') %>