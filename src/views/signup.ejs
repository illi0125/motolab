<%- include('includes/header') %>

  <link rel="stylesheet" type="text/css" href="/css/signup.css" />

  <body>
    <div class="motolab-signup-wrapper">
      <div class="bg-spotlight spot-orange"></div>
      <div class="bg-spotlight spot-cyan"></div>
      <div class="bg-cyber-grid"></div>

      <div class="signup-split-container">

        <aside class="brand-showcase-panel">
          <div class="brand-header">
            <div class="logo-icon-box">
              <svg class="speedometer-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 2a10 10 0 0 0-10 10c0 4.2 2.6 7.8 6.3 9.3" stroke-linecap="round" />
                <path d="M12 2a10 10 0 0 1 10 10c0 4.2-2.6 7.8-6.3 9.3" stroke-linecap="round" />
                <path d="M12 12l4-4" stroke="#FF3E00" stroke-width="2.5" stroke-linecap="round" />
                <circle cx="12" cy="12" r="2" fill="#FF3E00" />
              </svg>
            </div>
            <span class="brand-title">MOTO<span class="accent-text">LAB</span> <small>PRO</small></span>
          </div>

          <div class="showcase-content">
            <div class="telemetry-badge">
              <span class="pulse-dot"></span>
              <span>SYSTEM TELEMETRY v2.4 ONLINE</span>
            </div>
            <h1 class="showcase-heading">High-Performance <br /><span class="gradient-text">Fleet Management</span></h1>
            <p class="showcase-subtext">
              Access real-time diagnostics, ECU configuration metrics, track position telemetry, and administrative
              control center tools.
            </p>

            <div class="hud-stats-grid">
              <div class="hud-card">
                <span class="hud-label">LATENCY</span>
                <span class="hud-value cyan">12ms</span>
              </div>
              <div class="hud-card">
                <span class="hud-label">ENCRYPTION</span>
                <span class="hud-value orange">AES-256</span>
              </div>
              <div class="hud-card">
                <span class="hud-label">SYSTEM HEALTH</span>
                <span class="hud-value green">99.8%</span>
              </div>
            </div>
          </div>

          <div class="showcase-footer">
            <p>&copy; <%= new Date().getFullYear() %> MotoLab Operations. All telemetry rights reserved.</p>
          </div>
        </aside>

        <main class="form-card-panel">
          <div class="form-card-header">
            <h2>Create Admin Account</h2>
            <p>Already registered? <a href="/admin/login" class="link-highlight">Log in to dashboard</a></p>
          </div>

          <form onsubmit="return validateSignupForm()" action="/admin/signup" method="POST"
            enctype="multipart/form-data" class="motolab-form">
            <div class="input-grid">
              <div class="input-group">
                <label for="memberNick">Username / Admin ID *</label>
                <div class="input-field-wrapper">
                  <span class="field-icon">👤</span>
                  <input type="text" id="memberNick" name="memberNick" class="member-nick"
                    placeholder="e.g. Leo" required />
                </div>
              </div>

              <div class="input-group">
                <label for="memberPhone">Phone Number *</label>
                <div class="input-field-wrapper">
                  <span class="field-icon">📞</span>
                  <input type="text" id="memberPhone" name="memberPhone" class="member-phone"
                    placeholder="+8210 0000-0000" required />
                </div>
              </div>
            </div>

            <div class="input-group">
              <label for="memberRole">Department / Access Role *</label>
              <div class="input-field-wrapper">
                <span class="field-icon">🛡️</span>
                <select id="memberRole" name="memberRole" class="select-field">
                  <option value="RESTAURANT" selected>Lab Admin / Operations</option>
                  <option value="ENGINEER">Lead Telemetry Engineer</option>
                  <option value="TECHNICIAN">Fleet Maintenance Technician</option>
                </select>
              </div>
            </div>

            <div class="input-grid">
              <div class="input-group">
                <label for="memberPassword">Password *</label>
                <div class="input-field-wrapper">
                  <span class="field-icon">🔒</span>
                  <input type="password" id="memberPassword" name="memberPassword" class="member-password"
                    placeholder="••••••••••••" required />
                  <button type="button" class="password-toggle-btn" aria-label="Toggle password visibility">
                    👁️
                  </button>
                </div>
                <div class="strength-meter-container">
                  <div class="strength-bar">
                    <div class="strength-fill"></div>
                  </div>
                  <span class="strength-label">Password Strength</span>
                </div>
              </div>

              <div class="input-group">
                <label for="confirmPassword">Confirm Password *</label>
                <div class="input-field-wrapper">
                  <span class="field-icon">🔑</span>
                  <input type="password" id="confirmPassword" name="confirmPassword" class="confirm-password"
                    placeholder="••••••••••••" required />
                </div>
              </div>
            </div>

            <div class="input-group">
              <label>Avatar / Identity Verification Image *</label>
              <div class="image-upload-zone">
                <div class="avatar-preview-box">
                  <img class="upload-img-frame" src="/img/davidson.png" alt="Profile Preview" />
                </div>
                <div class="upload-controls">
                  <div class="file-input-wrapper">
                    <input type="text" class="upload-name-display" value="No image selected" readonly />
                    <label for="input-file" class="btn-browse">Browse Image</label>
                    <input type="file" id="input-file" class="upload-hidden-input member-image" name="memberImage"
                      accept=".jpg,.jpeg,.png" />
                  </div>
                  <p class="file-format-note">
                    Supported formats: <strong>.JPG, .JPEG, .PNG</strong> (Max 5MB)
                  </p>
                </div>
              </div>
            </div>

            <div class="terms-group">
              <label class="custom-checkbox">
                <input type="checkbox" id="termsCheck" required />
                <span class="checkmark"></span>
                <span class="terms-text">I acknowledge security protocols and agree to <a href="#"
                    class="link-highlight">MotoLab Terms of Service</a>.</span>
              </label>
            </div>

            <input name="memberType" value="RESTAURANT" hidden />

            <button class="submit-signup-btn" name="signup" type="submit">
              <span>Create Admin Account</span>
              <span class="btn-arrow">→</span>
            </button>
          </form>

          <div class="form-card-footer">
            <a href="/admin" class="btn-go-home">← Return to Main Portal</a>
          </div>
        </main>

      </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script type="text/javascript" src="/js/signup.js"></script>
  </body>

  <%- include('includes/footer') %>